{
  "compilerOptions": {
    "target": "ESNext",
    "moduleDetection": "force",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "./packages/gscdump" },
    { "path": "./packages/engine" },
    { "path": "./packages/lakehouse" },
    { "path": "./packages/cli" },
    { "path": "./packages/analysis" },
    { "path": "./packages/contracts" },
    { "path": "./packages/sdk" }
  ],
  "include": [],
  "exclude": ["node_modules", "dist"]
}
