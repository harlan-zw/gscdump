{
  "name": "@gscdump/db",
  "type": "module",
  "version": "0.1.3",
  "description": "SQLite persistence for Google Search Console data with Drizzle ORM",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/db#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/db"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "keywords": [
    "google-search-console",
    "gsc",
    "sqlite",
    "drizzle",
    "database",
    "seo",
    "data-persistence"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@googleapis/searchconsole": "catalog:deps",
    "db0": "catalog:",
    "drizzle-orm": "catalog:",
    "google-auth-library": "catalog:deps",
    "gscdump": "workspace:*",
    "ufo": "catalog:deps"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
