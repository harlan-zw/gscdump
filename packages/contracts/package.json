{
  "name": "@gscdump/contracts",
  "type": "module",
  "version": "2.3.0",
  "description": "Shared gscdump.com API, webhook, realtime, and lifecycle contracts.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./analytics": {
      "types": "./dist/analytics.d.mts",
      "import": "./dist/analytics.mjs",
      "default": "./dist/analytics.mjs"
    },
    "./archetypes": {
      "types": "./dist/archetypes.d.mts",
      "import": "./dist/archetypes.mjs",
      "default": "./dist/archetypes.mjs"
    },
    "./partner": {
      "types": "./dist/partner.d.mts",
      "import": "./dist/partner.mjs",
      "default": "./dist/partner.mjs"
    },
    "./v1": {
      "types": "./dist/v1/index.d.mts",
      "import": "./dist/v1/index.mjs",
      "default": "./dist/v1/index.mjs"
    },
    "./v1/browser": {
      "types": "./dist/v1/browser.d.mts",
      "import": "./dist/v1/browser.mjs",
      "default": "./dist/v1/browser.mjs"
    },
    "./v1/http": {
      "types": "./dist/v1/http.d.mts",
      "import": "./dist/v1/http.mjs",
      "default": "./dist/v1/http.mjs"
    },
    "./v1/realtime": {
      "types": "./dist/v1/realtime.d.mts",
      "import": "./dist/v1/realtime.mjs",
      "default": "./dist/v1/realtime.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "generate:v1-contracts": "pnpm run build && node scripts/generate-v1-contracts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:dev-build",
    "vitest": "catalog:dev-test"
  }
}
