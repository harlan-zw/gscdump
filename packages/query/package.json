{
  "name": "@gscdump/query",
  "type": "module",
  "version": "0.1.3",
  "description": "Unified data provider for Google Search Console - routes queries to API or SQLite database",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/query#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/query"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "keywords": [
    "google-search-console",
    "gsc",
    "data-provider",
    "abstraction",
    "api",
    "database"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "obuild --stub",
    "build": "obuild",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "google-auth-library": "catalog:deps"
  },
  "dependencies": {
    "@gscdump/db": "workspace:*",
    "gscdump": "workspace:*"
  }
}
