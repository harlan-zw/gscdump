  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@gscdump/contracts": "workspace:^",
    "gscdump": "workspace:^",
    "ofetch": "catalog:deps",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:dev-build",
    "vitest": "catalog:dev-test"
  }
}
