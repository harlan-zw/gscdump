    "./lifecycle": {
      "types": "./dist/lifecycle.d.mts",
      "import": "./dist/lifecycle.mjs",
      "default": "./dist/lifecycle.mjs"
    },
    "./period": {
      "types": "./dist/period.d.mts",
      "import": "./dist/period.mjs",
      "default": "./dist/period.mjs"
