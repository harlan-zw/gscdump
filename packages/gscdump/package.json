{
  "name": "gscdump",
  "type": "module",
  "version": "1.4.6",
  "description": "Direct Google Search Console client with typed queries, streaming pagination, URL inspection, and indexing helpers",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/gscdump#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/gscdump"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "keywords": [
    "google-search-console",
    "gsc",
    "seo",
    "search-analytics",
    "webmaster-tools",
    "query-builder",
    "indexing-api",
    "keyword-analysis",
    "edge-compatible"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./query": {
      "types": "./dist/query/index.d.mts",
      "import": "./dist/query/index.mjs",
      "default": "./dist/query/index.mjs"
    },
    "./query/plan": {
      "types": "./dist/query/plan.d.mts",
      "import": "./dist/query/plan.mjs",
      "default": "./dist/query/plan.mjs"
    },
    "./result": {
      "types": "./dist/core/result.d.mts",
      "import": "./dist/core/result.mjs",
      "default": "./dist/core/result.mjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.mts",
      "import": "./dist/contracts.mjs",
      "default": "./dist/contracts.mjs"
    },
    "./dates": {
      "types": "./dist/dates.d.mts",
      "import": "./dist/dates.mjs",
      "default": "./dist/dates.mjs"
    },
    "./normalize": {
      "types": "./dist/normalize.d.mts",
      "import": "./dist/normalize.mjs",
      "default": "./dist/normalize.mjs"
    },
    "./tenant": {
      "types": "./dist/tenant.d.mts",
      "import": "./dist/tenant.mjs",
      "default": "./dist/tenant.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "obuild --stub",
    "build": "obuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@gscdump/contracts": "workspace:^",
    "ofetch": "catalog:deps"
  }
}
