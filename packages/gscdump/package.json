{
  "name": "gscdump",
  "type": "module",
  "version": "0.4.0",
  "description": "Google Search Console API wrapper with typed query builder, streaming pagination, and SEO analysis functions",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/gscdump#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/gscdump"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "keywords": [
    "google-search-console",
    "gsc",
    "seo",
    "search-analytics",
    "webmaster-tools",
    "query-builder",
    "indexing-api",
    "keyword-analysis",
    "edge-compatible"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./query": {
      "types": "./dist/query/index.d.mts",
      "import": "./dist/query/index.mjs"
    },
    "./driver": {
      "types": "./dist/driver/index.d.mts",
      "import": "./dist/driver/index.mjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.mts",
      "import": "./dist/shared/index.mjs"
    },
    "./shared/analysis": {
      "types": "./dist/shared/analysis.d.mts",
      "import": "./dist/shared/analysis.mjs"
    },
    "./shared/driver": {
      "types": "./dist/shared/driver.d.mts",
      "import": "./dist/shared/driver.mjs"
    },
    "./shared/snapshot": {
      "types": "./dist/shared/snapshot.d.mts",
      "import": "./dist/shared/snapshot.mjs"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.mts",
      "import": "./dist/analytics/index.mjs"
    },
    "./analytics/contracts": {
      "types": "./dist/analytics/contracts.d.mts",
      "import": "./dist/analytics/contracts.mjs"
    },
    "./analytics/planner": {
      "types": "./dist/analytics/planner.d.mts",
      "import": "./dist/analytics/planner.mjs"
    },
    "./analytics/schema": {
      "types": "./dist/analytics/schema.d.mts",
      "import": "./dist/analytics/schema.mjs"
    },
    "./analytics/tenant": {
      "types": "./dist/analytics/tenant.d.mts",
      "import": "./dist/analytics/tenant.mjs"
    },
    "./analytics/normalize": {
      "types": "./dist/analytics/normalize.d.mts",
      "import": "./dist/analytics/normalize.mjs"
    },
    "./analytics/ingest": {
      "types": "./dist/analytics/ingest.d.mts",
      "import": "./dist/analytics/ingest.mjs"
    },
    "./analytics/sql": {
      "types": "./dist/analytics/sql-bind.d.mts",
      "import": "./dist/analytics/sql-bind.mjs"
    },
    "./analytics/node": {
      "types": "./dist/analytics/adapters/duckdb-node.d.mts",
      "import": "./dist/analytics/adapters/duckdb-node.mjs"
    },
    "./analytics/filesystem": {
      "types": "./dist/analytics/adapters/filesystem.d.mts",
      "import": "./dist/analytics/adapters/filesystem.mjs"
    },
    "./analytics/http": {
      "types": "./dist/analytics/adapters/http.d.mts",
      "import": "./dist/analytics/adapters/http.mjs"
    },
    "./analytics/hyparquet": {
      "types": "./dist/analytics/adapters/hyparquet.d.mts",
      "import": "./dist/analytics/adapters/hyparquet.mjs"
    },
    "./analytics/r2": {
      "types": "./dist/analytics/adapters/r2.d.mts",
      "import": "./dist/analytics/adapters/r2.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "obuild --stub",
    "build": "obuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run e2e/",
    "test:real": "RUN_REAL_CREDENTIALS=true vitest run e2e/real-credentials.test.ts",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@googleapis/indexing": "catalog:deps",
    "@googleapis/searchconsole": "catalog:deps",
    "hyparquet": "catalog:",
    "hyparquet-writer": "catalog:"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "@googleapis/indexing": {
      "optional": true
    },
    "@googleapis/searchconsole": {
      "optional": true
    },
    "hyparquet": {
      "optional": true
    },
    "hyparquet-writer": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "catalog:deps",
    "defu": "catalog:deps",
    "ofetch": "catalog:deps",
    "proper-lockfile": "catalog:deps",
    "ufo": "catalog:deps"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@googleapis/indexing": "catalog:deps",
    "@googleapis/searchconsole": "catalog:deps",
    "@types/proper-lockfile": "catalog:",
    "hyparquet": "catalog:",
    "hyparquet-writer": "catalog:"
  }
}
