{
  "name": "gscdump",
  "type": "module",
  "version": "0.25.2",
  "description": "Google Search Console API wrapper with typed query builder, streaming pagination, and SEO analysis functions",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/gscdump#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/gscdump"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "keywords": [
    "google-search-console",
    "gsc",
    "seo",
    "search-analytics",
    "webmaster-tools",
    "query-builder",
    "indexing-api",
    "keyword-analysis",
    "edge-compatible"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./query": {
      "types": "./dist/query/index.d.mts",
      "import": "./dist/query/index.mjs",
      "default": "./dist/query/index.mjs"
    },
    "./query/plan": {
      "types": "./dist/query/plan.d.mts",
      "import": "./dist/query/plan.mjs",
      "default": "./dist/query/plan.mjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.mts",
      "import": "./dist/contracts.mjs",
      "default": "./dist/contracts.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "obuild --stub",
    "build": "obuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@googleapis/indexing": "catalog:deps",
    "@googleapis/searchconsole": "catalog:deps"
  },
  "peerDependenciesMeta": {
    "@googleapis/indexing": {
      "optional": true
    },
    "@googleapis/searchconsole": {
      "optional": true
    }
  },
  "dependencies": {
    "@gscdump/contracts": "workspace:*",
    "date-fns": "catalog:deps",
    "defu": "catalog:deps",
    "ofetch": "catalog:deps",
    "ufo": "catalog:deps"
  },
  "devDependencies": {
    "@googleapis/indexing": "catalog:deps",
    "@googleapis/searchconsole": "catalog:deps"
  }
}
