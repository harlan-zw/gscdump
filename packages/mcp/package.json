{
  "name": "@gscdump/mcp",
  "type": "module",
  "version": "0.20.1",
  "private": true,
  "description": "MCP server for Google Search Console (frozen — not under active development).",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/mcp"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs",
      "default": "./dist/server/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "gscdump-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@gscdump/analysis": "workspace:*",
    "@gscdump/engine": "workspace:*",
    "@gscdump/engine-gsc-api": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "consola": "catalog:deps",
    "gscdump": "workspace:*",
    "ofetch": "catalog:deps",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:dev-test"
  }
}
