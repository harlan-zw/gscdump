{
  "name": "@gscdump/mcp",
  "type": "module",
  "version": "0.1.0",
  "description": "MCP server for Google Search Console - let AI agents query your search data",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-search-console",
    "gsc",
    "ai",
    "claude",
    "cursor",
    "seo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.mts",
      "import": "./dist/handlers/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "gscdump-mcp": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "dev": "obuild --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gscdump/query": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "gscdump": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@googleapis/searchconsole": "catalog:deps",
    "@gscdump/db": "workspace:*",
    "obuild": "catalog:dev-build",
    "typescript": "catalog:dev-build"
  }
}
