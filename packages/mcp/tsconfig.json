{
  "compilerOptions": {
    "target": "ESNext",
    "moduleDetection": "force",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/handlers/analysis.ts", "src/handlers/analytics.ts", "src/handlers/query.ts"]
}
