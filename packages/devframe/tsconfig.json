{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "types": [
      "node",
      "chrome"
    ]
  },
  "include": [
    "src/**/*.ts",
    "app/**/*.ts",
    "test/**/*.ts",
    "playground/**/*.ts",
    "extension/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
