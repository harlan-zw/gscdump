    "@modelcontextprotocol/sdk": "catalog:",
    "citty": "catalog:deps",
    "consola": "catalog:deps",
    "dayjs": "catalog:deps",
    "db0": "catalog:",
    "google-auth-library": "catalog:deps",
    "gscdump": "workspace:*",
    "open": "catalog:deps"
  },
  "devDependencies": {
    "vitest": "catalog:dev-test"
  }
}
