{
  "name": "@gscdump/cli",
  "type": "module",
  "version": "1.0.3",
  "description": "CLI for Google Search Console - dump, query, and run MCP server",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "keywords": [
    "google-search-console",
    "gsc",
    "seo",
    "cli",
    "mcp",
    "search-analytics",
    "data-export"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs",
      "default": "./dist/cli.mjs"
    }
  },
  "bin": {
    "gscdump": "./bin/gscdump.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:deps",
    "@duckdb/node-api": "catalog:",
    "@gscdump/analysis": "workspace:^",
    "@gscdump/engine": "workspace:^",
    "@gscdump/engine-gsc-api": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "citty": "catalog:deps",
    "consola": "catalog:deps",
    "google-auth-library": "catalog:deps",
    "gscdump": "workspace:^",
    "ofetch": "catalog:deps",
    "open": "catalog:deps",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:dev-test"
  }
}
