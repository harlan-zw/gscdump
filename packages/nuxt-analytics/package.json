{
  "name": "@gscdump/nuxt-analytics",
  "type": "module",
  "version": "0.11.5",
  "description": "Nuxt layer: GSC analytics UI + DuckDB-WASM integration. Frontend-only; server primitives live in @gscdump/analysis, @gscdump/engine-sqlite, @gscdump/cloudflare, and host apps.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/nuxt-analytics"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types.ts",
      "import": "./nuxt.config.ts",
      "default": "./nuxt.config.ts"
    },
    "./types": {
      "types": "./types.ts",
      "import": "./types.ts",
      "default": "./types.ts"
    },
    "./module": {
      "types": "./module.ts",
      "import": "./module.ts",
      "default": "./module.ts"
    },
    "./site-url": {
      "types": "./site-url.ts",
      "import": "./site-url.ts",
      "default": "./site-url.ts"
    }
  },
  "main": "./nuxt.config.ts",
  "types": "./types.ts",
  "files": [
    "README.md",
    "app",
    "module.ts",
    "nuxt.config.ts",
    "site-url.ts",
    "types.ts"
  ],
  "scripts": {
    "build": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "peerDependencies": {
    "nuxt": "catalog:",
    "vue": "catalog:"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@gscdump/analysis": "workspace:*",
    "@gscdump/contracts": "workspace:*",
    "@gscdump/engine": "workspace:*",
    "@gscdump/engine-duckdb-wasm": "workspace:*",
    "@gscdump/sdk": "workspace:*",
    "@nuxt/ui": "catalog:",
    "@unovis/ts": "catalog:",
    "@unovis/vue": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "defu": "catalog:deps",
    "gscdump": "workspace:*",
    "ofetch": "catalog:deps",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:dev-build",
    "vue": "catalog:"
  }
}
