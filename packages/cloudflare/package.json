{
  "name": "@gscdump/cloudflare",
  "type": "module",
  "version": "0.32.10",
  "description": "Cloudflare-Workers-flavored helpers for the gscdump analytics stack: AnalyticsEnv binding contract, R2 SigV4 presigner, size-hint HMAC, DuckDB Workers shims, engine factory.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/cloudflare#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/cloudflare"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server-tail": {
      "types": "./dist/server-tail/index.d.mts",
      "import": "./dist/server-tail/index.mjs",
      "default": "./dist/server-tail/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test:workers": "GSCDUMP_E2E=1 vitest --run --config vitest.workers.config.ts",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "h3": "^1.15.0"
  },
  "dependencies": {
    "@gscdump/contracts": "workspace:*",
    "@gscdump/engine": "workspace:*",
    "@gscdump/engine-sqlite": "workspace:*",
    "@uwdata/flechette": "catalog:",
    "aws4fetch": "catalog:",
    "gscdump": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "h3": "catalog:",
    "typescript": "catalog:dev-build",
    "wrangler": "catalog:"
  }
}
