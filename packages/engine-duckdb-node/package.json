{
  "name": "@gscdump/engine-duckdb-node",
  "type": "module",
  "version": "0.5.0",
  "description": "Node DuckDB engine adapter for @gscdump/analysis — SQL analyzer dispatch over parquet via duckdb-node.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/engine-duckdb-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/engine-duckdb-node"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@gscdump/analysis": "workspace:*",
    "@gscdump/engine": "workspace:*",
    "drizzle-orm": "catalog:",
    "gscdump": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:dev-test"
  }
}
