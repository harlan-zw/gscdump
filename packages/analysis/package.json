{
  "name": "@gscdump/analysis",
  "type": "module",
  "version": "0.38.2",
  "description": "GSC analyzers — striking-distance, opportunity, movers, decay, brand, clustering, concentration, seasonality. Pure row-based + DuckDB-native.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/gscdump/tree/main/packages/analysis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git",
    "directory": "packages/analysis"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/gscdump/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./analyzer": {
      "types": "./dist/analyzer/index.d.mts",
      "import": "./dist/analyzer/index.mjs",
      "default": "./dist/analyzer/index.mjs"
    },
    "./registry": {
      "types": "./dist/default-registry.d.mts",
      "import": "./dist/default-registry.mjs",
      "default": "./dist/default-registry.mjs"
    },
    "./source": {
      "types": "./dist/source/index.d.mts",
      "import": "./dist/source/index.mjs",
      "default": "./dist/source/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "import": "./dist/errors.mjs",
      "default": "./dist/errors.mjs"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.mts",
      "import": "./dist/semantic/index.mjs",
      "default": "./dist/semantic/index.mjs"
    },
    "./report": {
      "types": "./dist/report/index.d.mts",
      "import": "./dist/report/index.mjs",
      "default": "./dist/report/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@huggingface/transformers": "catalog:"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "@gscdump/engine": "workspace:*",
    "@gscdump/engine-gsc-api": "workspace:*",
    "drizzle-orm": "catalog:",
    "gscdump": "workspace:*",
    "pluralize": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:dev-test"
  }
}
