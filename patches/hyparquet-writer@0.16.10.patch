+  // PATCH (gscdump): truncate to a UTF8 CHARACTER boundary within
+  // STATS_TRUNCATE_LENGTH bytes. The upstream code cut at exactly 16 bytes,
+  // which splits a multibyte UTF8 sequence mid-character — the resulting min/max
+  // stat is invalid UTF8, and strict parquet readers (DuckDB / DuckDB-WASM)
+  // reject the ENTIRE file ("Invalid string encoding found in Parquet file"),
+  // so every browser/worker DuckDB read of a slice with non-ASCII queries/urls
+  // fell back to the server. Backing the cut off any trailing continuation byte
+  // (0b10xxxxxx) guarantees the prefix ends on a complete character.
+  let cut = STATS_TRUNCATE_LENGTH
+  while (cut > 0 && (bytes[cut] & 0xc0) === 0x80) cut--
+  const prefix = bytes.slice(0, cut)
+  if (!isMax) return prefix // a char-boundary prefix is a valid lower bound
+  // Upper bound: prefix + U+10FFFF (the maximum code point, F4 8F BF BF) is
+  // valid UTF8 and >= the original — no valid UTF8 char can sort after U+10FFFF,
+  // so this is a sound upper bound without a byte-level increment that could
+  // itself produce invalid UTF8. Slightly looser than the tightest prefix-round
+  // but correct, and string-column range pruning is not on any hot path.
+  const out = new Uint8Array(prefix.length + 4)
+  out.set(prefix, 0)
