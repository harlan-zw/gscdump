+// Private, per-manifest-walk admission. No default policy and no global state.
+const fields = ['maxObjectBytes', 'maxTotalObjectBytes', 'maxManifests', 'maxEntries',
+  'maxInflatedBlockBytes', 'maxTotalInflatedBytes', 'maxValueBytes',
+  'maxDecodedValues', 'maxHeaderBytes', 'maxSchemaDepth']
+
+export function createAvroBudget(options) {
+  if (options === undefined) return undefined
+  if (!options || typeof options !== 'object' || Array.isArray(options)) throw new TypeError('Invalid manifest read limits')
+  const limits = {}
+  for (const key of Object.keys(options)) if (!fields.includes(key)) throw new TypeError(`Unknown manifest read limit: ${key}`)
+  for (const key of fields) {
+    const value = options[key]
+    if (!Number.isSafeInteger(value) || value <= 0) throw new RangeError(`Invalid manifest read limit: ${key}`)
+    limits[key] = value
+  }
+  if (limits.maxSchemaDepth > 128) throw new RangeError('Manifest schema depth must not exceed 128')
+  Object.freeze(limits)
+  const used = { objectBytes: 0, inflatedBytes: 0, manifests: 0, entries: 0, values: 0 }
+  let failed = false, failure
+  const check = () => { if (failed) throw failure }
+  const fail = error => { if (!failed) { failed = true; failure = error }; throw failure }
+  const bound = (value, max, label) => {
+    check()
+    if (!Number.isSafeInteger(value) || value < 0 || value > max) fail(new RangeError(`Manifest read limit exceeded: ${label}`))
+  }
+  const charge = (key, value, max) => { bound(value, max - used[key], key); used[key] += value }
+  return Object.freeze({
+    limits, check, fail, bound,
+    object(bytes) { bound(bytes, limits.maxObjectBytes, 'objectBytes'); charge('objectBytes', bytes, limits.maxTotalObjectBytes) },
+    records(count, kind) { charge(kind, count, kind === 'manifests' ? limits.maxManifests : limits.maxEntries) },
+    values(count) { charge('values', count, limits.maxDecodedValues) },
+    availableValues(count) { bound(count, limits.maxDecodedValues - used.values, 'values') },
+    inflateLimit() { check(); return Math.min(limits.maxInflatedBlockBytes, limits.maxTotalInflatedBytes - used.inflatedBytes) },
+    inflated(bytes) { bound(bytes, limits.maxInflatedBlockBytes, 'inflatedBlockBytes'); charge('inflatedBytes', bytes, limits.maxTotalInflatedBytes) },
+    schema(value) {
+      // Validate before recursively compiling. JSON itself was byte-bounded
+      // before JSON.parse; this is not a claim about the JSON parser's heap.
+      const stack = [{ value, depth: 0 }]
+      while (stack.length) {
+        const next = stack.pop()
+        bound(next.depth, limits.maxSchemaDepth, 'schemaDepth')
+        charge('values', 1, limits.maxDecodedValues)
+        if (next.value && typeof next.value === 'object') {
+          const keys = Object.keys(next.value)
+          bound(stack.length + keys.length, limits.maxDecodedValues - used.values, 'schemaValues')
+          for (const key of keys) stack.push({ value: next.value[key], depth: next.depth + 1 })
+        }
+      }
+    },
+  })
+}
+
+export function boundedBytes(reader, length, max) {
+  const budget = reader.budget
+  budget?.bound(length, max ?? budget.limits.maxValueBytes, 'valueBytes')
+  budget?.bound(reader.offset + length, reader.headerEnd ?? reader.view.byteLength, 'encodedBytes')
+  return new Uint8Array(reader.view.buffer, reader.view.byteOffset + reader.offset, length)
+}
+
+export function boundedLong(reader) {
+  let value = 0n
+  for (let shift = 0; shift < 70; shift += 7) {
+    reader.budget.bound(reader.offset + 1, reader.headerEnd ?? reader.view.byteLength, 'varintBytes')
+    const byte = reader.view.getUint8(reader.offset++)
+    if (shift === 63 && byte > 1) reader.budget.fail(new RangeError('Invalid Avro long'))
+    value |= BigInt(byte & 127) << BigInt(shift)
+    if (!(byte & 128)) return (value >> 1n) ^ -(value & 1n)
+  }
+  return reader.budget.fail(new RangeError('Invalid Avro long'))
+}
