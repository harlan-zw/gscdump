# Google OAuth Credentials for E2E Testing
# Get these from Google Cloud Console

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Tokens (obtain via OAuth flow)
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# Set to true to run real credential tests
RUN_REAL_CREDENTIALS=false
