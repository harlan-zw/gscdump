{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run -r build",
    "dev": "pnpm run -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm run -r typecheck",
    "test": "vitest --run && pnpm --filter @gscdump/cloudflare test",
    "test:contracts": "pnpm --filter @gscdump/sdk... build && pnpm --filter gscdump exec vitest run test/core/contracts.test.ts test/query/builder.test.ts test/query/metrics.test.ts test/query/plan.test.ts && pnpm --filter @gscdump/contracts exec vitest run test/contracts.test.ts test/v1.test.ts test/bing-indexing-evidence-v1.test.ts && pnpm --filter @gscdump/contracts typecheck && pnpm --filter @gscdump/sdk exec vitest run test/v1-http.test.ts test/v1-realtime.test.ts test/bing-indexing-evidence-v1.test.ts && pnpm --filter @gscdump/sdk typecheck",
    "test:e2e": "vitest --run --config tests/e2e/vitest.config.ts",
    "release": "pnpm build && bumpp --output=CHANGELOG.md packages/*/package.json packages/sdk/src/v1/realtime.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev-lint",
    "@gscdump/engine": "workspace:*",
    "@gscdump/engine-gsc-api": "workspace:*",
    "@nuxt/test-utils": "catalog:dev-test",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:dev-build",
    "bumpp": "catalog:dev-build",
    "eslint": "catalog:dev-lint",
    "gscdump": "workspace:*",
    "js-yaml": "catalog:",
    "obuild": "catalog:dev-build",
    "rolldown": "catalog:dev-build",
    "typescript": "catalog:dev-build",
    "vitest": "catalog:dev-test",
    "vitest-package-exports": "catalog:"
  }
}
