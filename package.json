{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git"
  },
  "scripts": {
    "build": "pnpm run -r build",
    "dev": "pnpm run -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm run -r typecheck",
    "test": "vitest --run",
    "test:e2e": "vitest --project e2e",
    "release": "pnpm build && bumpp --output=CHANGELOG.md packages/*/package.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev-lint",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "aws4fetch": "catalog:",
    "bumpp": "catalog:dev-build",
    "dotenv": "catalog:dev-test",
    "eslint": "catalog:dev-lint",
    "js-yaml": "catalog:",
    "obuild": "catalog:dev-build",
    "tinyexec": "catalog:",
    "typescript": "catalog:dev-build",
    "vitest": "catalog:dev-test",
    "vitest-package-exports": "catalog:"
  }
}
