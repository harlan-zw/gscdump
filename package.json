{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/gscdump.git"
  },
  "scripts": {
    "build": "pnpm run -r build",
    "dev": "pnpm run -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm run -r typecheck",
    "test": "vitest --run",
    "test:contracts": "pnpm --filter gscdump test -- --run test/core/contracts.test.ts test/query/builder.test.ts test/query/metrics.test.ts test/query/plan.test.ts && vitest --run packages/nuxt/test/contracts.test.ts && pnpm --filter @gscdump/nuxt typecheck",
    "test:e2e": "vitest --run --config tests/e2e/vitest.config.ts",
    "release": "pnpm build && bumpp --output=CHANGELOG.md packages/*/package.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev-lint",
    "@nuxt/test-utils": "catalog:dev-test",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "aws4fetch": "catalog:",
    "bumpp": "catalog:dev-build",
    "eslint": "catalog:dev-lint",
    "gscdump": "workspace:*",
    "js-yaml": "catalog:",
    "obuild": "catalog:dev-build",
    "typescript": "catalog:dev-build",
    "vitest": "catalog:dev-test",
    "vitest-package-exports": "catalog:"
  }
}
