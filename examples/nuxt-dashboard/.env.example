# Cloudflare R2 S3 credentials — used by the Nitro manifest + sign-url + server
# analysis routes. The client never sees these; all client reads go through
# /api/manifest + /api/sign-url.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Which prefix the demo's dashboard loads. In production this comes from the
# logged-in user's session; here it's pinned via env for the example.
GSCDUMP_USER_ID=
GSCDUMP_SITE_ID=
